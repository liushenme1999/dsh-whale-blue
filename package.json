{
  "name": "dsh-whale-blue",
  "version": "1.3.0",
  "description": "Repaint the DeepSeek Harness whale DeepSeek blue — a DSH bundle installable from the Plugins page, with a settings item under Settings > 通用设置 > 外观 and a companion patcher for the tray icon, window icon and welcome mark.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-whale-blue": "./bin/cli.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "bin",
    "lib",
    "install.cmd",
    "restore.cmd",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "theme",
    "brand",
    "whale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushenme1999/dsh-whale-blue.git"
  },
  "homepage": "https://github.com/liushenme1999/dsh-whale-blue#readme",
  "bugs": {
    "url": "https://github.com/liushenme1999/dsh-whale-blue/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
